{
  "name": "zors-bot",
  "version": "1.0.0",
  "description": "Test-guild-first Discord bot and server management tooling for Betrayed.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build": "tsc",
    "check:config": "tsx src/check-config.ts",
    "dev": "tsx watch src/index.ts",
    "plan:test": "tsx src/planning/plan-test.ts",
    "plan:production": "tsx src/planning/plan-production.ts",
    "plan:production:hash": "tsx src/planning/production-plan-hash.ts",
    "plan:production:retirement": "tsx src/planning/plan-production-retirement.ts",
    "apply:production": "tsx src/planning/apply-production.ts",
    "retire:production": "tsx src/planning/apply-production-retirement.ts",
    "snapshot:test": "tsx src/planning/snapshot-test.ts",
    "plan:hash": "tsx src/planning/plan-hash.ts",
    "apply:test": "tsx src/planning/apply-test.ts",
    "cleanup:hash": "tsx src/planning/cleanup-hash.ts",
    "cleanup:test": "tsx src/planning/cleanup-test.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swoodfork/betrayed.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/swoodfork/betrayed/issues"
  },
  "homepage": "https://github.com/swoodfork/betrayed#readme",
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.27.0",
    "dotenv": "^18.0.9",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
